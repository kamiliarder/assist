#!/usr/bin/env python3
"""Headless ordis core daemon. Owns the session and the model connection.

GUIs (`ordis`) attach over a Unix socket (see ordis/ipc). Under systemd it is socket-activated:
the socket unit holds %t/ordis/control.sock and starts this on first use. Run by hand it binds
the socket itself and refuses to start if another ordis-core is already answering there.
"""
import os
import pathlib
import signal
import sys
import threading

# Allow reading the API key from a file (e.g. mounted by sops-nix or agenix).
key_file = os.environ.get("ORDIS_API_KEY_FILE") or os.environ.get("NVIDIA_API_KEY_FILE")
if key_file:
    try:
        os.environ["ORDIS_API_KEY"] = pathlib.Path(key_file).read_text().strip()
    except OSError:
        pass

from ordis.core import Core
from ordis.core.config import load
from ordis.ipc.protocol import resolve_socket_path
from ordis.ipc.server import AlreadyRunning, Server, activation_socket, bind_socket


def main():
    cfg = load()
    path = resolve_socket_path(cfg.socket_path)

    listener = activation_socket()
    owned = listener is None
    try:
        if listener is None:
            listener = bind_socket(path)
    except AlreadyRunning as e:
        print(f"ordis-core: {e}", file=sys.stderr)
        sys.exit(1)

    core = Core()
    server = Server(core, listener, path=path, owned=owned)
    stop = threading.Event()
    server.on_shutdown = stop.set
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: stop.set())

    server.start()
    print(f"ordis-core listening on {path}"
          f"{' (socket-activated)' if not owned else ''}", file=sys.stderr, flush=True)
    stop.wait()

    server.stop()   # cancels any turn, which closes the model connection
    core.shutdown()


if __name__ == "__main__":
    main()
